CompileFlags:
  CompilationDatabase: .

Diagnostics:
  ClangTidy:
    Add: [bugprone-*, performance-*]
    Remove: [bugprone-easily-swappable-parameters, bugprone-narrowing-conversions, performance-unnecessary-value-param]
  UnusedIncludes: None

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: No

---
If:
  PathMatch: [external/.*, build/.*]
Diagnostics:
  Suppress: '*'
